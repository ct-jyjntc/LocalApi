{
  "name": "localapi-server",
  "version": "1.0.0",
  "private": true,
  "description": "Local API relay with response caching",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mock": "tsx src/mock-upstream.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
