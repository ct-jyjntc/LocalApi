[Unit]
Description=LocalAPI relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localapi
Group=localapi
WorkingDirectory=/opt/localapi/server
EnvironmentFile=/etc/localapi.env
ExecStart=/usr/bin/node /opt/localapi/server/dist/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/localapi/server/data

[Install]
WantedBy=multi-user.target
